# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string for the game server.
DATABASE_URL=postgres://bhabi:bhabi@localhost:5432/bhabi_thulla

# Secret used to sign player session credentials.
SESSION_SIGNING_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to reach the API (must include the Netlify URL).
WEB_ORIGINS=http://localhost:5173

# Public backend origin baked into the frontend build (not a secret).
VITE_API_URL=http://localhost:4000
